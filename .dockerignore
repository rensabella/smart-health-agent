# Only reviewed application sources enter the Docker build context.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!README.md
!app/
!app/**
!skills/
!skills/**
!scripts/
!scripts/**
!frontend/
!frontend/**
!evaluation/
!evaluation/*.py
!evaluation/test_cases.json
!examples/
!examples/*.py
!configs/
!configs/**
!.streamlit/
!.streamlit/config.toml
!knowledge/
!knowledge/**
!train.py
!generate_demo_data.py
!data/
!data/sample/
!data/sample/demo.csv

# Keep these excluded even if they appear under an allowed source directory.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.env
**/.env.*
**/*.joblib
**/*.pkl
**/*.pickle
**/*.onnx
**/*.bin
**/*.pt
**/*.pth
**/*.safetensors
**/*.sqlite
**/*.db
