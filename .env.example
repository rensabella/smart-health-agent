# Mutable storage defaults to the process working directory; never site-packages.
# HEALTH_HOME=/absolute/path/to/smarthealth-state
HEALTH_LOG_LEVEL=INFO
HEALTH_API_HOST=127.0.0.1
HEALTH_API_PORT=8000
# Documentation only: export these variables in your shell/process manager.
# This application does not automatically read .env files.
HEALTH_AGENT_BACKEND=disabled
# Set openai_compatible only when configuring a real tool-calling provider.
HEALTH_LLM_BASE_URL=https://api.openai.com/v1
HEALTH_LLM_MODEL=your-tool-calling-model
HEALTH_LLM_API_KEY=set-locally
# Use your own bearer token when enabling nonlocal data access.
HEALTH_API_TOKEN=set-locally
# Optional: HEALTH_MODEL_DIR and HEALTH_AGENT_TRACE_DIR override local paths.
# Operator-owned YAML directory; loaded once on startup. Restart to apply changes.
# HEALTH_HARNESS_CONFIG_DIR=/absolute/path/to/configs
# Opt in to the nine-Skill, five-role educational report profile:
# HEALTH_HARNESS_CONFIG_DIR=/absolute/path/to/configs/report

# Disabled by default. Build the pinned semantic index explicitly before enabling.
# Application startup never downloads models, documents, or indexes.
HEALTH_RAG_MODE=disabled
# HEALTH_RAG_MODE=local
# HEALTH_RAG_MODEL_DIR=/absolute/path/to/data/models/multilingual-e5-small
# HEALTH_RAG_INDEX_DIR=/absolute/path/to/data/knowledge/v1
# Cosine ranking threshold; not a confidence or citation-support probability.
HEALTH_RAG_MIN_SCORE=0.78

# Short-term: bounded local memory. Long-term: local Qdrant, summary payloads only.
HEALTH_MEMORY_MODE=local
# Use ephemeral for tests/demos that should not survive restart.
# HEALTH_MEMORY_DIR=/absolute/path/to/private/qdrant-memory
HEALTH_MEMORY_SESSION_TTL_SECONDS=3600
HEALTH_MEMORY_RETENTION_SECONDS=2592000

# Streamlit server only. End users enter their API bearer token in the sidebar.
# Never put the provider API key in the frontend.
HEALTH_API_BASE_URL=http://127.0.0.1:8000
