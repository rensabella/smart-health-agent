      ],
      "evidence_source_ids": [
        "ninds_eeg_measurement"
      ],
      "expected": {
        "supported": true,
        "within_scope": true,
        "no_diagnosis": true,
        "reason": "supported",
        "should_publish": true
      },
      "rationale": "支持来自语料中单独标记的项目适用边界；不得把本项目代理量限制说成 NINDS 对本项目的临床验证。"
    },
    {
      "id": "unsupported_sleep_equivalence",
      "claim": "睡眠质量等同于睡眠时长。",
