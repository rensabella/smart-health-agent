{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json_message": {"()": "smarthealth.runtime.logging.JsonFormatter"},
    "server": {"format": "%(levelname)s %(message)s"}
  },
  "handlers": {
    "application": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "json_message"
    },
    "server": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr",
      "formatter": "server"
    }
  },
  "loggers": {
    "smart_health": {"handlers": ["application"], "level": "INFO", "propagate": false},
    "uvicorn": {"handlers": ["server"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"level": "INFO"},
    "uvicorn.access": {"handlers": [], "propagate": false}
  },
  "root": {"handlers": ["server"], "level": "WARNING"}
}
